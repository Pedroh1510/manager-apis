VITE_RSS_API_URL=
VITE_MANGAS_API_URL=
# server/ (Express): runtime env, never VITE_*. Absent QBITTORRENT_URL disables the integration.
PORT=3002
QBITTORRENT_URL=
QBITTORRENT_USER=
QBITTORRENT_PASS=
SONARR_URL=
SONARR_API_KEY=
# Upload de episódios (opcional; exige SONARR_URL). Caminho absoluto de uma pasta montada no
# MESMO caminho no container do manager-apis e no do Sonarr, com escrita para os dois
# (ex.: dono PUID:PGID do Sonarr e chmod 775). Sem ela, o upload fica desligado.
# Uploads longos podem cair no proxy do Coolify (Traefik): se acontecer, suba o
# entryPoints.<ep>.transport.respondingTimeouts.readTimeout do proxy.
SONARR_UPLOAD_DIR=
# Tdarr (opcional, somente leitura). TDARR_API_KEY só quando o Tdarr roda com auth=true;
# exige TDARR_URL. Ex.: TDARR_URL=http://10.0.0.2:8265 no .env.local.
# TDARR_URL=
# TDARR_API_KEY=
# Jikan (temporadas de anime): API pública, sem chave. Só defina para trocar a base,
# ex.: um mirror ou um Jikan self-hosted. Padrão: https://api.jikan.moe/v4
# JIKAN_URL=
# Dev: um .env.local (ignorado pelo git) é lido antes do .env e vence nele,
# ex.: SONARR_URL=http://localhost:8989 do `docker compose --profile sonarr up -d sonarr`.
